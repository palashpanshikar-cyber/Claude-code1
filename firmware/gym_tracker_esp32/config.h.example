// Copy this file to config.h and fill in your values.
// config.h is per-device (each machine's sensor gets its own device_id/key
// from the seed script output) — never commit config.h to git.

#define WIFI_SSID "your-gym-wifi"
#define WIFI_PASSWORD "your-wifi-password"

// Backend base URL, with no trailing slash. Either scheme works — the
// sketch picks a TLS or plain client to match — so this is the only line
// to change when you move from a laptop on the gym WiFi to a hosted
// backend:
//   LAN     "http://192.168.1.50:3001"
//   hosted  "https://gympulse.onrender.com"
// Use https:// for a hosted backend, not http://: hosts redirect plain
// HTTP away and this sketch does not follow redirects.
#define BACKEND_URL "http://192.168.1.50:3001"

// From `npm run seed` output in backend/, or shown once when you add a
// machine in the admin panel — one pair per machine.
#define DEVICE_ID "dev_ac423779"
#define DEVICE_KEY "169236bf89d5e90f0c0f4196a91db865"
